/* ---------------------------------------------------------------- checks */

function grade(r) {
  const g = tk.wcagGrade(r);
  return `<span class="grade ${g === "Fail" ? "f" : g === "AA large" ? "w" : ""}">${g}</span>`;
}

function renderChecks() {
  const v = [];
  // text contrast
  const pairs = [["ink", "background", "Titles on the page", 3], ["body", "background", "Body text on the page", 4.5], ["ink", "panel", "Titles on a card", 3], ["body", "panel", "Body text on a card", 4.5]];
  $("#tb-contrast").innerHTML = pairs.map(([fg, bg, what]) => {
    const r = tk.contrast(B[fg], B[bg]);
    return `<div class="crow"><span class="sample" style="color:${B[fg]};background:${B[bg]}">Aa 12</span><span class="what">${what}</span><span class="ratio">${r.toFixed(1)}:1</span>${grade(r)}</div>`;
  }).join("");
  const bodyBg = tk.contrast(B.body, B.background), bodyPn = tk.contrast(B.body, B.panel), inkBg = tk.contrast(B.ink, B.background);
  if (bodyBg < 4.5) v.push(["bad", `Body text is ${bodyBg.toFixed(1)}:1 on the background. Small labels need 4.5:1: make the body text ${isDark() ? "lighter" : "darker"}.`]);
  else if (bodyPn < 4.5) v.push(["", `Body text is ${bodyPn.toFixed(1)}:1 on the panel colour, below 4.5:1. Make the panel closer to the background, or the body text ${isDark() ? "lighter" : "darker"}.`]);
  if (inkBg < 3) v.push(["bad", `Titles are ${inkBg.toFixed(1)}:1 on the background. Even large text needs 3:1.`]);

  // data colours on background
  const weak = [];
  $("#tb-oncanvas").innerHTML = `<div class="oc" style="background:${B.background};padding:10px;border-radius:10px;border:1px solid ${B.hairline}">` + B.colors.map((c, i) => {
    const r = tk.contrast(c, B.background); if (r < 3) weak.push(i + 1);
    return `<div class="ocell"><svg width="46" height="22" viewBox="0 0 46 22"><polyline points="2,18 14,9 26,13 44,3" fill="none" stroke="${c}" stroke-width="2.5" stroke-linecap="round"/></svg><span style="color:${B.body}">${i + 1}: ${r.toFixed(1)}:1</span>${r < 3 ? '<span class="grade w">thin lines</span>' : '<span class="grade">OK</span>'}</div>`;
  }).join("") + "</div>";
  if (weak.length) v.push(["", `${weak.length > 1 ? "Colours" : "Colour"} ${listAnd(weak)} ${weak.length > 1 ? "have" : "has"} less than 3:1 against the background: fine as a bar or a filled area, weak as a thin line or a small dot. Use ${weak.length > 1 ? "them" : "it"} for fills, or ${isDark() ? "lighten" : "darken"} ${weak.length > 1 ? "them" : "it"}.`]);

  // colour vision
  const cp = tk.closestPairs(B.colors);
  const flagged = [];
  $("#tb-cvd").innerHTML = `<div class="cvd">` + ["normal", "deutan", "protan", "tritan", "achroma"].map((k) => {
    const best = cp[k], d = best.d, sim = B.colors.map((c) => (k === "normal" ? c : tk.simulate(c, k)));
    const lvl = d < 5 ? "f" : d < 10 ? "w" : "";
    if (d < 10) flagged.push([k, best]);
    return `<div class="cv"><div><b>${VISION[k].name}</b><small>${VISION[k].who}</small></div>
      <div class="cvstrip">${sim.map((c, i) => `<i style="background:${c}" class="${d < 10 && (i === best.i || i === best.j) ? "hit" : ""}" title="${i + 1}: ${c}"><em>${i + 1}</em></i>`).join("")}</div>
      <div class="cvr">${best.i + 1} and ${best.j + 1}: ${d.toFixed(1)}<br><span class="grade ${lvl}">${d < 5 ? "look the same" : d < 10 ? "close" : "clear"}</span></div></div>`;
  }).join("") + "</div>";
  for (const [k, best] of flagged) {
    const a = ord(best.i + 1), b = ord(best.j + 1), same = best.d < 5;
    let line;
    if (k === "normal") line = `Your ${a} and ${b} colours are ${same ? "almost the same" : "close"} for every reader (distance ${best.d.toFixed(1)}). Change one, or move them apart in the list.`;
    else if (k === "achroma") line = `In a black-and-white print your ${a} and ${b} colours turn into ${same ? "the same grey" : "nearly the same grey"}. Make one lighter or darker.`;
    else line = `Your ${a} and ${b} colours look ${same ? "the same" : "alike"} to ${VISION[k].who.split(", ")[1]} (${VISION[k].name.toLowerCase()}). Change one, or never put them side by side.`;
    v.push([same ? "bad" : "", line]);
  }
  if (!v.length) v.push(["ok", `All checks pass: text reads well on the page and on cards, and the ${B.colors.length} series stay apart for every type of colour vision tested.`]);
  $("#tb-verdicts").innerHTML = v.map(([cls, t]) => `<li class="${cls}">${esc(t)}</li>`).join("");
  // flag rows in the editor
  $$("#tb-colors li").forEach((li) => {
    const i = +li.dataset.i, hit = flagged.some(([, bst]) => bst.i === i || bst.j === i);
    li.querySelector(".cn").style.color = hit ? "var(--warn)" : "";
    li.querySelector(".cn").title = hit ? "Close to another colour, see the checks" : i >= 6 ? "Power BI and Python only, Office keeps 6" : "Series " + (i + 1);
  });
}

/* ---------------------------------------------------------------- downloads */

const FILE_INFO = [
  { idx: 0, app: "Power BI", desc: "Report theme: data colours, text classes, axes, gridlines, KPI colours.", type: "application/json" },
  { idx: 1, app: "PowerPoint, Excel, Word", desc: "Office theme with slide master: 6 accents, text colours, fonts.", type: "application/vnd.ms-officetheme", view: 2 },
  { idx: 3, app: "matplotlib", desc: "Style sheet: colour cycle, background, grid, spines, fonts.", type: "text/plain" },
  { idx: 4, app: "plotly", desc: "Template: colourway, fonts, axes, colour scales.", type: "application/json" },
  { idx: 5, app: "Vega-Lite", desc: "Config object: category range, axes, legend, title.", type: "application/json" },
  { idx: 6, app: "CSS", desc: "Custom properties --theme-* for every role and series.", type: "text/css" },
  { idx: 7, app: "brand.json", desc: "Your inputs. Drop it back here to edit this theme later.", type: "application/json" },
];
let FILES = [];
const base = (n) => n.split("/").pop();
const bytes = (d) => (typeof d === "string" ? new TextEncoder().encode(d).length : d.length);

function renderDownloads() {
  FILES = tk.allFiles(B);
  const s = tk.slug(B.name), total = FILES.reduce((a, f) => a + bytes(f.data), 0);
  $("#tb-zipname").textContent = s + "-theme-pack.zip";
  $("#tb-zipsize").textContent = FILES.length + " files, " + fmtB(total) + ", with a README that says which file goes where";
  $("#tb-files").innerHTML = FILE_INFO.map((fi, k) => {
    const f = FILES[fi.idx];
    return `<div class="file${k === viewFile ? " on" : ""}"><b>${fi.app}</b><span class="fnm">${esc(base(f.name))} · ${fmtB(bytes(f.data))}</span><span class="fdesc">${fi.desc}</span>
      <div class="btnrow"><button type="button" class="btn2 small" data-dl="${k}">Download</button><button type="button" class="btn2 small quiet" data-view="${k}">View</button></div></div>`;
  }).join("");
  const fi = FILE_INFO[viewFile], shown = FILES[fi.view ?? fi.idx];
  $("#tb-vname").textContent = fi.view ? base(FILES[fi.idx].name) + " is a zip; this is the theme1.xml inside it" : base(shown.name);
  $("#tb-view").textContent = shown.data;
  const names = { pbi: base(FILES[0].name), thmx: base(FILES[1].name), mpl: base(FILES[3].name), plotly: base(FILES[4].name), vega: base(FILES[5].name), css: base(FILES[6].name) };
  for (const [k, n] of Object.entries(names)) $$(".fn-" + k).forEach((el) => { el.textContent = n; });
}

$("#tb-files").addEventListener("click", (e) => {
  const d = e.target.closest("[data-dl]"), vw = e.target.closest("[data-view]");
  if (d) { const fi = FILE_INFO[+d.dataset.dl], f = FILES[fi.idx]; tk.download(base(f.name), f.data, fi.type); status("Saved " + base(f.name) + ". The clicks to apply it are under How to apply."); }
  if (vw) { viewFile = +vw.dataset.view; renderDownloads(); }
});
$("#tb-zip").addEventListener("click", () => {
  const name = tk.slug(B.name) + "-theme-pack.zip";
  tk.download(name, tk.zip(tk.allFiles(B)), "application/zip");
  status("Saved " + name + ". Unzip it: one folder per tool, and a README.");
});
$("#tb-copy").addEventListener("click", async () => {
  try { await navigator.clipboard.writeText($("#tb-view").textContent); $("#tb-copy").textContent = "Copied"; setTimeout(() => ($("#tb-copy").textContent = "Copy"), 1400); } catch (e) { /* ignore */ }
});

/* ---------------------------------------------------------------- fonts for the preview */

const askedFonts = new Set();
function loadFonts() {
  for (const f of [B.fontHeading, B.fontBody]) {
    const k = f.toLowerCase();
    if (OFFICE_ONLY.has(k) || askedFonts.has(k) || !/^[A-Za-z0-9 ]{2,40}$/.test(f)) continue;
    askedFonts.add(k);
    const l = document.createElement("link"); l.rel = "stylesheet";
    l.href = "https://fonts.googleapis.com/css2?family=" + encodeURIComponent(f.trim()).replace(/%20/g, "+") + ":wght@400;600&display=swap";
    l.onload = () => document.fonts && document.fonts.ready.then(renderPreview);
    document.head.appendChild(l);
  }
}

/* ---------------------------------------------------------------- update loop */

let slowTimer = 0, fontTimer = 0;
function update() {
  renderPreview();
  renderChecks();
  writeHash();
  clearTimeout(slowTimer); slowTimer = setTimeout(renderDownloads, 120);
  clearTimeout(fontTimer); fontTimer = setTimeout(loadFonts, 700);
}

const init = initialBrand();
{ // optional ?view=slide and ?vision=deutan, so a link can open straight on a check
  const q = new URLSearchParams(location.search);
  if (q.get("view") === "slide") { view = "slide"; $$(".seg [data-view]").forEach((x) => { x.classList.toggle("on", x.dataset.view === "slide"); x.setAttribute("aria-selected", x.dataset.view === "slide"); }); $("#tb-pbi").hidden = true; $("#tb-slide").hidden = false; }
  if (VISION[q.get("vision")]) { vision = q.get("vision"); $("#tb-vision").value = vision; }
}
setBrand(init.brand, { preset: init.preset });
renderDownloads();
if (init.msg) status(init.msg);
window.addEventListener("hashchange", () => {
  const h = new URLSearchParams(location.hash.slice(1));
  if (h.get(KEYS.colors) && h.toString() !== toParams(B).toString()) { setBrand(fromParams(h)); status("Loaded the theme from the link."); }
});
</script>
