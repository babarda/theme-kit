<script type="module" is:inline>
import * as tk from "/tools/themekit/themekit.js";

const $ = (s, r = document) => r.querySelector(s);
const $$ = (s, r = document) => [...r.querySelectorAll(s)];
const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]);
const PRESETS = JSON.parse($("#tb-presets").textContent);
const ROLES = [["background", "Background", "page and slide"], ["panel", "Panel", "cards and visual backgrounds"], ["ink", "Ink", "titles and big numbers"], ["body", "Body text", "labels, axes, paragraphs"], ["hairline", "Hairline", "borders and axis lines"], ["gridline", "Gridline", "chart gridlines"]];
const SENT = [["good", "Good", "on target, going up"], ["bad", "Bad", "off target, going down"], ["neutral", "Neutral", "flat, watch"]];
const KEYS = { name: "n", colors: "c", background: "bg", panel: "panel", ink: "ink", body: "body", hairline: "hair", gridline: "grid", good: "good", bad: "bad", neutral: "neutral", fontHeading: "fh", fontBody: "fb" };
const OFFICE_ONLY = new Set(["segoe ui", "segoe ui semibold", "segoe ui light", "aptos", "aptos display", "calibri", "calibri light", "arial", "arial narrow", "georgia", "cambria", "verdana", "tahoma", "trebuchet ms", "century gothic", "franklin gothic book", "franklin gothic medium", "garamond", "gill sans mt", "candara", "corbel", "constantia", "palatino linotype", "book antiqua", "times new roman", "consolas", "system-ui", "sans-serif", "serif"]);
const VISION = {
  normal: { name: "Normal vision", who: "most readers" },
  deutan: { name: "Deuteranopia", who: "green-blind, about 1 in 17 men" },
  protan: { name: "Protanopia", who: "red-blind, about 1 in 50 men" },
  tritan: { name: "Tritanopia", who: "blue-blind, about 1 in 10,000 people" },
  achroma: { name: "Greyscale print", who: "the office printer, e-ink, fax" },
};
const ord = (n) => n + (n % 100 >= 11 && n % 100 <= 13 ? "th" : ["th", "st", "nd", "rd"][n % 10] || "th");
const listAnd = (a) => (a.length < 2 ? String(a[0]) : a.slice(0, -1).join(", ") + " and " + a[a.length - 1]);
const fmtB = (n) => (n >= 1024 ? (n / 1024).toFixed(n >= 10240 ? 0 : 1) + " KB" : n + " B");

let B = tk.completeBrand(tk.DEFAULT_BRAND);
let vision = "normal", view = "pbi", preDark = null, activePreset = null, viewFile = 0;

/* ---------------------------------------------------------------- state */

function clean(b) {
  const out = tk.completeBrand(b);
  out.colors = out.colors.slice(0, 10);
  if (out.colors.length < 2) out.colors.push(tk.mix(out.colors[0], out.colors[0] === "#FFFFFF" ? -0.5 : 0.45));
  out.fontHeading = String(out.fontHeading || "Segoe UI").slice(0, 60);
  out.fontBody = String(out.fontBody || "Segoe UI").slice(0, 60);
  return out;
}

function setBrand(b, opts = {}) {
  B = clean(b);
  activePreset = opts.preset || null;
  if (!opts.keepDark) preDark = null;
  renderEditor();
  update();
}

function status(msg, err) { const s = $("#tb-status"); s.textContent = msg || ""; s.classList.toggle("err", !!err); }

/* ---------------------------------------------------------------- URL */

function toParams(b) {
  const p = new URLSearchParams();
  p.set(KEYS.name, b.name);
  p.set(KEYS.colors, b.colors.map((c) => c.slice(1)).join(","));
  for (const [r] of [...ROLES, ...SENT]) p.set(KEYS[r], b[r].slice(1));
  p.set(KEYS.fontHeading, b.fontHeading); p.set(KEYS.fontBody, b.fontBody);
  return p;
}

function fromParams(p) {
  const b = {};
  if (p.get(KEYS.name)) b.name = p.get(KEYS.name);
  if (p.get(KEYS.colors)) b.colors = p.get(KEYS.colors).split(/[,\s;]+/).map(tk.normHex).filter(Boolean);
  for (const [r] of [...ROLES, ...SENT]) if (p.get(KEYS[r])) b[r] = tk.normHex(p.get(KEYS[r])) || undefined;
  if (p.get(KEYS.fontHeading)) b.fontHeading = p.get(KEYS.fontHeading);
  if (p.get(KEYS.fontBody)) b.fontBody = p.get(KEYS.fontBody);
  return b;
}

const hashString = () => toParams(B).toString().replace(/%2C/gi, ",");
let hashTimer = 0;
function writeHash() {
  clearTimeout(hashTimer);
  hashTimer = setTimeout(() => { try { history.replaceState(null, "", location.pathname + location.search + "#" + hashString()); } catch (e) { /* file:// or sandbox */ } }, 250);
}

/* A full brand from a few colours: tk.brandFromColors fills the neutrals from colour 1 and pads
   1 to 3 colours with shades and tints. Capped at 6 series so the padding does not crowd the palette. */
function fromFew(cols, name) {
  const b = tk.brandFromColors(cols.slice(0, 3), name);
  b.colors = cols.length > 3 ? cols.slice(0, 10) : b.colors.slice(0, Math.max(6, cols.length));
  return b;
}

function initialBrand() {
  const h = new URLSearchParams(location.hash.slice(1));
  const q = new URLSearchParams(location.search);
  if (h.get(KEYS.colors)) return { brand: fromParams(h), msg: "Loaded the theme from the link." };
  const preset = q.get("preset") && PRESETS.find((p) => p.id === q.get("preset").toLowerCase());
  if (preset) return { brand: preset.brand, preset: preset.id, msg: "Loaded " + preset.name + "." };
  const cols = (q.get("colors") || q.get(KEYS.colors) || "").split(/[,\s;]+/).map(tk.normHex).filter(Boolean);
  if (cols.length) {
    const name = q.get("name") || q.get(KEYS.name) || "Slide palette";
    const base = fromFew(cols, name);
    const full = fromParams(q); delete full.colors; delete full.name;
    return { brand: { ...base, ...full }, msg: "Built a theme from " + cols.length + " colour" + (cols.length > 1 ? "s" : "") + " in the link. Check the neutrals and the colour order below." };
  }
  return { brand: tk.DEFAULT_BRAND, msg: "" };
}

/* ---------------------------------------------------------------- editor */

function colorRow(c, i, n) {
  return `<li class="${i >= 6 ? "off" : ""}" data-i="${i}">
    <span class="cn" title="${i >= 6 ? "Power BI and Python only, Office keeps 6" : "Series " + (i + 1)}">${i + 1}</span>
    <input type="color" value="${c.toLowerCase()}" aria-label="Colour ${i + 1}" />
    <input type="text" value="${c}" maxlength="7" spellcheck="false" aria-label="Hex code of colour ${i + 1}" />
    <button type="button" class="ib" data-act="up" aria-label="Move colour ${i + 1} up" ${i === 0 ? "disabled" : ""}>&#8593;</button>
    <button type="button" class="ib" data-act="down" aria-label="Move colour ${i + 1} down" ${i === n - 1 ? "disabled" : ""}>&#8595;</button>
    <button type="button" class="ib x" data-act="del" aria-label="Remove colour ${i + 1}" ${n <= 2 ? "disabled" : ""}>&#215;</button>
  </li>`;
}

function roleRow([key, label, what]) {
  return `<div class="role" data-role="${key}">
    <input type="color" value="${B[key].toLowerCase()}" aria-label="${label}" />
    <input type="text" value="${B[key]}" maxlength="7" spellcheck="false" aria-label="${label} hex code" />
    <span>${label}<small>${what}</small></span>
  </div>`;
}

function renderEditor() {
  $("#tb-name").value = B.name;
  $("#tb-colors").innerHTML = B.colors.map((c, i) => colorRow(c, i, B.colors.length)).join("");
  $("#tb-add").disabled = B.colors.length >= 10;
  $("#tb-count").textContent = B.colors.length + " of 10";
  $("#tb-roles").innerHTML = ROLES.map(roleRow).join("");
  $("#tb-sent").innerHTML = SENT.map(roleRow).join("");
  $("#tb-fh").value = B.fontHeading; $("#tb-fb").value = B.fontBody;
  $$(".preset").forEach((el) => el.classList.toggle("on", el.dataset.id === activePreset));
  syncDarkLabel();
}

const isDark = () => tk.luminance(B.background) < 0.2;
function syncDarkLabel() { $("#tb-dark").textContent = isDark() ? "Light mode version" : "Dark mode version"; }

function onEdit() { activePreset = null; $$(".preset.on").forEach((el) => el.classList.remove("on")); update(); }

function bindSwatchInputs(container, get, set) {
  container.addEventListener("input", (e) => {
    const t = e.target, host = t.closest("[data-i],[data-role]");
    if (!host) return;
    if (t.type === "color") {
      const v = tk.normHex(t.value); set(host, v);
      const txt = host.querySelector("input[type=text]"); txt.value = v; txt.classList.remove("bad");
      onEdit();
    } else if (t.type === "text") {
      const v = tk.normHex(t.value);
      t.classList.toggle("bad", !v);
      if (v) { set(host, v); host.querySelector("input[type=color]").value = v.toLowerCase(); onEdit(); }
    }
  });
  container.addEventListener("focusout", (e) => {
    const t = e.target, host = t.closest("[data-i],[data-role]");
    if (host && t.type === "text") { t.value = get(host); t.classList.remove("bad"); }
  });
}

bindSwatchInputs($("#tb-colors"), (h) => B.colors[+h.dataset.i], (h, v) => { B.colors[+h.dataset.i] = v; });
bindSwatchInputs($("#tb-roles"), (h) => B[h.dataset.role], (h, v) => { B[h.dataset.role] = v; syncDarkLabel(); });
bindSwatchInputs($("#tb-sent"), (h) => B[h.dataset.role], (h, v) => { B[h.dataset.role] = v; });

$("#tb-colors").addEventListener("click", (e) => {
  const btn = e.target.closest("button[data-act]"); if (!btn) return;
  const i = +btn.closest("li").dataset.i, c = B.colors, act = btn.dataset.act;
  if (act === "up" && i > 0) [c[i - 1], c[i]] = [c[i], c[i - 1]];
  if (act === "down" && i < c.length - 1) [c[i + 1], c[i]] = [c[i], c[i + 1]];
  if (act === "del" && c.length > 2) c.splice(i, 1);
  renderEditor(); onEdit();
  const target = act === "up" ? i - 1 : act === "down" ? i + 1 : Math.min(i, c.length - 1);
  const again = $(`#tb-colors li[data-i="${target}"] button[data-act="${act}"]`) || $(`#tb-colors li[data-i="${target}"] input[type=text]`);
  if (again && !again.disabled) again.focus();
});

$("#tb-add").addEventListener("click", () => {
  if (B.colors.length >= 10) return;
  const pool = [...tk.DEFAULT_BRAND.colors, "#16A085", "#D35400", "#7F8C8D", "#2C3E50", "#E84393", "#00A8E8"];
  let c = pool.find((p) => B.colors.every((x) => tk.deltaE(x, p) > 12));
  if (!c) c = tk.mix(B.colors[B.colors.length - 1], 0.4);
  B.colors.push(c); renderEditor(); onEdit();
  $(`#tb-colors li[data-i="${B.colors.length - 1}"] input[type=text]`).focus();
});

$("#tb-name").addEventListener("input", (e) => { B.name = e.target.value.trim() || "My Brand"; update(); });
$("#tb-fh").addEventListener("input", (e) => { B.fontHeading = e.target.value.trim() || "Segoe UI"; update(); });
$("#tb-fb").addEventListener("input", (e) => { B.fontBody = e.target.value.trim() || "Segoe UI"; update(); });

function lightNeutrals(base) {
  return { background: "#FFFFFF", panel: tk.mix(base, 0.94), ink: tk.mix(base, -0.8), body: tk.mix(base, -0.6), hairline: tk.mix(base, 0.8), gridline: tk.mix(base, 0.9) };
}
function darkNeutrals(base) {
  return { background: tk.mix(base, -0.88), panel: tk.mix(base, -0.8), ink: tk.mix(base, 0.93), body: tk.mix(base, 0.72), hairline: tk.mix(base, -0.62), gridline: tk.mix(base, -0.72) };
}

$("#tb-gen").addEventListener("click", () => {
  const base = B.colors[0];
  Object.assign(B, isDark() ? darkNeutrals(base) : lightNeutrals(base));
  preDark = null; renderEditor(); onEdit();
  status("Built the six neutrals from colour 1 (" + base + "): tints for background, panel and lines, shades for text.");
});

$("#tb-dark").addEventListener("click", () => {
  if (isDark()) {
    if (preDark) { Object.assign(B, preDark); preDark = null; status("Back to the light version you had before."); }
    else { Object.assign(B, lightNeutrals(B.colors[0])); status("Built light neutrals from colour 1."); }
    renderEditor(); onEdit(); return;
  }
  preDark = { colors: B.colors.slice() }; for (const [r] of ROLES) preDark[r] = B[r];
  Object.assign(B, darkNeutrals(B.colors[0]));
  const lifted = [];
  B.colors = B.colors.map((c, i) => {
    if (tk.contrast(c, B.background) >= 3) return c;
    let k = 0.1, out = c;
    while (k <= 0.8 && tk.contrast(out, B.background) < 3) { out = tk.mix(c, k); k += 0.05; }
    lifted.push(i + 1); return out;
  });
  renderEditor(); onEdit();
  status("Dark background, light text." + (lifted.length ? " Lightened colour" + (lifted.length > 1 ? "s " : " ") + listAnd(lifted) + " so " + (lifted.length > 1 ? "they stay" : "it stays") + " visible on it." : "") + " Press the button again to go back.");
});

