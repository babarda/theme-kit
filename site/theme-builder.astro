---
import Layout from "../../layouts/Layout.astro";
import presetData from "../../../public/tools/themekit/presets.json";
const presets = presetData.presets;
const OFFICE_FONTS = ["Segoe UI", "Segoe UI Semibold", "Segoe UI Light", "Aptos", "Aptos Display", "Calibri", "Calibri Light", "Arial", "Arial Narrow", "Georgia", "Cambria", "Verdana", "Tahoma", "Trebuchet MS", "Century Gothic", "Franklin Gothic Book", "Franklin Gothic Medium", "Garamond", "Gill Sans MT", "Candara", "Corbel", "Constantia", "Palatino Linotype", "Book Antiqua", "Times New Roman", "Consolas", "Source Sans Pro", "Open Sans", "Roboto", "Lato", "Poppins", "Montserrat", "Inter", "EB Garamond", "Oswald", "Rethink Sans"];
const ff = (f: string) => `'${f}', 'Segoe UI', system-ui, sans-serif`;
---
<Layout
  title="Theme Builder: Power BI, Office, Python and CSS themes from one brand · Badr Abardazzou"
  description="Free theme builder. Pick one of 16 report looks, paste your brand hex codes or drop a theme file, check contrast and colour-blind safety on a live report page and slide, then download matching themes for Power BI (.json), PowerPoint, Excel and Word (.thmx), matplotlib, plotly, Vega-Lite and CSS. Runs in your browser, nothing uploaded."
  active="tools"
>
  <div class="pa tool bcg tb">
    <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=Figtree:wght@400;500;600;700&family=EB+Garamond:wght@400;600&family=Rethink+Sans:wght@400;600&family=Poppins:wght@400;600&family=Oswald:wght@400;600&display=swap" rel="stylesheet" />
    <script type="application/json" is:inline id="tb-presets" set:html={JSON.stringify(presets)}></script>
    <datalist id="tb-fonts">{OFFICE_FONTS.map((f) => <option value={f} />)}</datalist>

    <div class="head">
      <p class="eyebrow"><a href="/tools/">Tools</a></p>
      <h1>Theme Builder</h1>
      <p class="dek">Enter your brand colours once and download matching themes for Power BI, PowerPoint, Excel, Word, matplotlib, plotly, Vega-Lite and CSS. A live report page and slide show the result, and the checks tell you which colours clash before your readers do.</p>
    </div>

    <ol class="steps">
      <li><span class="two-n">1</span><div><b>Pick or enter colours</b><p>Start from one of 16 report looks, paste the hex codes from your brand guide, or drop a theme file you already use.</p></div></li>
      <li><span class="two-n">2</span><div><b>Check</b><p>The preview redraws as you type. The checks flag text that is hard to read and series that colour-blind readers cannot tell apart.</p></div></li>
      <li><span class="two-n">3</span><div><b>Download</b><p>One zip with every file, or one file at a time, each with the exact clicks to apply it.</p></div></li>
    </ol>

    <!-- ============================================================ 1. START -->
    <h2 class="sec" id="start"><span class="secn">1</span>Start from a look, your hex codes or a file</h2>
    <p class="secnote2">Each card shows the look on its own background: title in its ink colour, data colours in series order.</p>
    <div class="presets" id="presets">
      {presets.map((p) => (
        <button type="button" class="preset" data-id={p.id} style={`background:${p.brand.background};border-color:${p.brand.hairline}`} aria-label={`Load the ${p.name} look, made for ${p.madeFor}`}>
          <span class="pn" style={`color:${p.brand.ink};font-family:${ff(p.brand.fontHeading)}`}>{p.name}</span>
          <span class="pm" style={`color:${p.brand.body}`}>{p.madeFor}</span>
          <span class="pstrip">{p.brand.colors.map((c) => <i style={`background:${c}`}></i>)}</span>
        </button>
      ))}
    </div>

    <div class="inputs">
      <div class="card">
        <label class="ck" for="tb-paste">Paste your brand hex codes</label>
        <textarea id="tb-paste" rows="4" spellcheck="false" placeholder="Paste anything: #1F4E79, F39C12, rgb(39,174,96), a line from a brand guide or a CSS file. Every colour code in the text is picked up."></textarea>
        <div class="row">
          <span class="found" id="tb-found">No colour found yet.</span>
          <button type="button" class="btn2" id="tb-use-paste" disabled>Use these colours</button>
        </div>
        <p class="hint">White and near-black greys in the list become the background and the text colour. The rest become data colours, in the order you pasted them.</p>
      </div>
      <div class="card drop" id="tb-drop" tabindex="0" role="button" aria-label="Load a theme or brand file">
        <span class="ck">Load a file</span>
        <p class="dl"><b>Drop a file here</b>, or <button type="button" id="tb-choose">choose one</button></p>
        <p class="hint">brand.json from this page, a Power BI theme .json, an Office .thmx, or any .pptx, .potx, .xlsx or .docx: the tool reads the theme inside it.</p>
        <input type="file" id="tb-file" hidden accept=".json,.thmx,.pptx,.potx,.ppsx,.xlsx,.xltx,.docx,.dotx" />
      </div>
    </div>
    <p class="status" id="tb-status" role="status" aria-live="polite"></p>

    <!-- ============================================================ 2. EDIT + PREVIEW -->
    <h2 class="sec" id="edit"><span class="secn">2</span>Adjust and check</h2>
    <div class="work">
      <div class="editor">
        <div class="field">
          <label class="ck" for="tb-name">Theme name</label>
          <input type="text" id="tb-name" maxlength="60" autocomplete="off" />
        </div>

        <div class="field">
          <div class="fhead"><span class="ck">Data colours</span><span class="fnote" id="tb-count"></span></div>
          <p class="hint">Series 1 takes colour 1 in every chart, in every tool. Office keeps the first 6.</p>
          <ol class="colors" id="tb-colors"></ol>
          <button type="button" class="btn2 add" id="tb-add">Add a colour</button>
        </div>

        <div class="field">
          <span class="ck">Neutrals</span>
          <div class="roles" id="tb-roles"></div>
          <div class="btnrow">
            <button type="button" class="btn2" id="tb-gen">Generate neutrals from my first colour</button>
            <button type="button" class="btn2" id="tb-dark">Dark mode version</button>
          </div>
        </div>

        <div class="field">
          <span class="ck">Good, bad, neutral</span>
          <p class="hint">Used for KPI arrows, variance and conditional formatting.</p>
          <div class="roles" id="tb-sent"></div>
        </div>

        <div class="field">
          <span class="ck">Fonts</span>
          <div class="fonts">
            <label>Headings<input type="text" id="tb-fh" list="tb-fonts" autocomplete="off" /></label>
            <label>Body text<input type="text" id="tb-fb" list="tb-fonts" autocomplete="off" /></label>
          </div>
          <p class="hint">Pick a font installed on every machine that opens the file. Segoe UI, Aptos, Calibri, Arial and Georgia are safe on Windows and Office.</p>
        </div>

        <div class="btnrow">
          <button type="button" class="btn2" id="tb-share">Copy share link</button>
          <button type="button" class="btn2 quiet" id="tb-reset">Start over</button>
        </div>
      </div>

      <div class="stage">
        <div class="bar">
          <div class="seg" role="tablist" aria-label="Preview">
            <button type="button" role="tab" data-view="pbi" class="on" aria-selected="true">Power BI page</button>
            <button type="button" role="tab" data-view="slide" aria-selected="false">Slide</button>
          </div>
          <div class="seg small" aria-label="Colour vision">
            <span class="segk">See it as</span>
            <select id="tb-vision" aria-label="Simulate colour vision">
              <option value="normal">normal vision</option>
              <option value="deutan">deuteranopia (green-blind)</option>
              <option value="protan">protanopia (red-blind)</option>
              <option value="tritan">tritanopia (blue-blind)</option>
              <option value="achroma">greyscale print</option>
            </select>
          </div>
        </div>
        <div class="canvas" id="tb-pbi"></div>
        <div class="canvas" id="tb-slide" hidden></div>
        <p class="capt" id="tb-capt">Mock data. Every colour, font and line comes from your theme.</p>
        <div class="checks" id="checks">
          <h3 class="sub">What the checks found</h3>
          <ul class="verdicts" id="tb-verdicts"></ul>
          <div class="cgrid">
            <div class="cbox">
              <h4>Text contrast <span class="secnote">WCAG 2: 4.5:1 for body text, 3:1 for large text</span></h4>
              <div id="tb-contrast"></div>
            </div>
            <div class="cbox">
              <h4>Data colours on the background <span class="secnote">3:1 or more keeps lines and small marks visible</span></h4>
              <div id="tb-oncanvas"></div>
            </div>
          </div>
          <div class="cbox wide">
            <h4>Can every reader tell the series apart? <span class="secnote">closest pair per type of vision, CIEDE2000 distance, below 10 is a warning</span></h4>
            <div id="tb-cvd"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- ============================================================ 3. DOWNLOAD -->
    <h2 class="sec" id="download"><span class="secn">3</span>Download</h2>
    <div class="dlmain">
      <button type="button" class="dlbtn" id="tb-zip">Download all (zip)</button>
      <div class="dlmeta"><b id="tb-zipname"></b><span id="tb-zipsize"></span></div>
    </div>
    <div class="files" id="tb-files"></div>
    <div class="viewer">
      <div class="vhead"><span class="ck" id="tb-vname"></span><button type="button" class="btn2 small" id="tb-copy">Copy</button></div>
      <pre id="tb-view" tabindex="0"></pre>
    </div>

    <!-- ============================================================ HOW TO APPLY -->
    <h2 class="sec" id="apply">How to apply each file</h2>
    <div class="apply">
      <div class="ap"><b>Power BI Desktop</b><p><span class="k">View</span> tab, <span class="k">Themes</span>, <span class="k">Browse for themes</span>, pick <code class="fn-pbi"></code>. Every visual takes the data colours, fonts, axis and gridline colours at once.</p></div>
      <div class="ap"><b>PowerPoint</b><p><span class="k">Design</span> tab, the <span class="k">More</span> arrow at the bottom right of the Themes gallery, <span class="k">Browse for Themes</span>, pick <code class="fn-thmx"></code>. To keep it: same arrow, <span class="k">Save Current Theme</span>. To make it the default: right-click it in the gallery, <span class="k">Set as Default Theme</span>.</p></div>
      <div class="ap"><b>Excel</b><p><span class="k">Page Layout</span> tab, <span class="k">Themes</span>, <span class="k">Browse for Themes</span>, pick <code class="fn-thmx"></code>. Charts, tables, cell styles and the colour picker switch to your colours and fonts.</p></div>
      <div class="ap"><b>Word</b><p><span class="k">Design</span> tab, <span class="k">Themes</span>, <span class="k">Browse for Themes</span>, pick <code class="fn-thmx"></code>. Headings take your heading font, charts and SmartArt take your colours.</p></div>
      <div class="ap"><b>matplotlib</b><pre><code>{`import matplotlib.pyplot as plt
plt.style.use("`}<span class="fn-mpl"></span>{`")`}</code></pre></div>
      <div class="ap"><b>plotly</b><pre><code>{`import json, plotly.io as pio, plotly.graph_objects as go
with open("`}<span class="fn-plotly"></span>{`") as f:
    pio.templates["brand"] = go.layout.Template(json.load(f))
pio.templates.default = "brand"`}</code></pre></div>
      <div class="ap"><b>Vega-Lite</b><pre><code>{`const config = await (await fetch("`}<span class="fn-vega"></span>{`")).json();
vegaEmbed("#chart", spec, { config });`}</code></pre></div>
      <div class="ap"><b>CSS</b><pre><code>{`<link rel="stylesheet" href="`}<span class="fn-css"></span>{`">
.card { background: var(--theme-panel); color: var(--theme-ink); }
.bar-1 { fill: var(--theme-series-1); }`}</code></pre></div>
    </div>

    <!-- ============================================================ BOOKNOTES -->
    <div class="notes">
    <div class="booknote">
      <b>What is in the pack.</b> <code>powerbi/&lt;name&gt;.json</code> is a Power BI report theme: data colours, text classes for titles, labels and callouts, the page and visual background, axis and gridline colours, good, bad and neutral for KPIs and conditional formatting, and the table accent. <code>office/&lt;name&gt;.thmx</code> is an Office theme with a 16:9 slide master: dark and light text colours, six accents, heading and body fonts, read by PowerPoint, Excel, Word and Outlook. <code>office/theme1.xml</code> is the same theme as a raw part, for anyone who swaps it inside a .pptx or .xlsx by hand. <code>python/&lt;name&gt;.mplstyle</code> sets the matplotlib colour cycle, background, text, grid and spines. <code>python/plotly-&lt;name&gt;.json</code> is a plotly template with the colourway and a sequential and diverging scale. <code>web/vega-lite-&lt;name&gt;.json</code> is a Vega-Lite config object. <code>web/&lt;name&gt;.css</code> holds CSS custom properties, <code>--theme-series-1</code> onwards. <code>brand.json</code> holds your inputs: drop it back on this page next year and you edit the same theme instead of starting again.
    </div>

    <div class="booknote">
      <b>Why the order of the data colours matters.</b> Power BI, Office, matplotlib, plotly and Vega-Lite all hand out colours in list order: the first series gets colour 1, the second gets colour 2, and so on. So colour 1 is the colour your readers see most, and colours 1 and 2 sit next to each other in almost every chart. Put your main brand colour first, put a clear contrast second, and keep two similar colours far apart in the list. Office stores six accents, so a seventh data colour reaches Power BI and Python but not PowerPoint.
    </div>

    <div class="booknote">
      <b>Why the contrast and colour-blind checks matter.</b> About 1 man in 12 (8%) and 1 woman in 200 have a red-green colour deficiency, so in a meeting of twenty people at least one reader usually cannot tell a red bar from a green one. The tool simulates each deficiency at full strength (Machado, Oliveira and Fernandes, 2009) and measures the distance between every pair of data colours with CIEDE2000: below 10 two series start to merge on a chart, below 5 most people see one colour. Greyscale shows what the office printer does to your report. For text, WCAG 2 asks for 4.5:1 against the background for body text and 3:1 for large headings and chart marks.
    </div>

    <div class="booknote">
      <b>Privacy.</b> Everything runs in this page. A file you drop is read by your browser and never uploaded, and the downloads are built on your machine. The share link carries your colours after the # sign, which browsers do not send to any server. The one outside call: when you type a font name the page does not know, the preview asks Google Fonts for that name so it can draw it.
    </div>

    <div class="booknote">
      <b>Related.</b> Already have a theme file and want to know if it holds up? <a href="/tools/theme-check/">Theme Check</a> reads a Power BI .json, a .thmx or any Office file and runs the same checks. Want slides that already use a theme like these? See the <a href="/templates/">templates</a>, where "Build a theme from this slide" opens this page with the slide's colours loaded. The 16 looks come from the design languages of the Open Visualization Protocol.
    </div>
    </div>
  </div>
</Layout>

<style is:global>
  .shell:has(.tb){ max-width:1180px; }
  .pa.bcg{ --serif:'Source Serif 4', Georgia, serif; --sans:'Figtree', 'Segoe UI', system-ui, sans-serif; --mono:'Figtree', 'Segoe UI', system-ui, sans-serif; font-family:var(--sans); font-variant-numeric:tabular-nums; }
  .pa.bcg h1{ letter-spacing:-.4px; font-weight:600; }
  .pa.bcg .dek{ font-family:var(--sans); font-style:normal; font-weight:400; font-size:1.08rem; line-height:1.55; }
  .pa.bcg .eyebrow, .pa.bcg .ck{ font-weight:600; letter-spacing:.12em; }
  .pa{ --panel:#FBFCFB; --body:#293a35; --pass:#0E7C6B; --fail:#C0402E; --warn:#B07C1F; color:var(--body); font-size:1.02rem; line-height:1.6; }
  .pa a{ color:var(--teal-ink); text-decoration:underline; text-underline-offset:3px; text-decoration-thickness:1.5px; text-decoration-color:rgba(14,157,138,.4); }
  .pa a:hover{ color:var(--teal); text-decoration-color:var(--teal); }
  .tb .head{ padding:clamp(30px,5vw,52px) 0 clamp(14px,2vw,22px); }
  .tb .eyebrow{ display:inline-flex; align-items:center; gap:10px; font-family:var(--mono); font-size:.7rem; letter-spacing:.2em; text-transform:uppercase; color:var(--teal-ink); margin:0 0 20px; }
  .tb .eyebrow::before{ content:""; width:26px; height:1px; background:var(--teal); }
  .tb .eyebrow a{ color:inherit; text-decoration:none; }
  .tb h1{ font-family:var(--serif); font-weight:600; font-size:clamp(2.1rem,5vw,3.1rem); line-height:1.08; letter-spacing:-.7px; margin:0; color:#101B18; }
  .tb .dek{ color:var(--mid); margin:18px 0 0; max-width:66ch; }

  .tb .steps{ list-style:none; padding:0; display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin:22px 0 0; }
  .tb .steps li{ display:flex; gap:14px; align-items:flex-start; padding:16px 18px; background:var(--panel); border:1px solid var(--hair-2); border-radius:14px; }
  .tb .two-n{ flex:none; width:30px; height:30px; border-radius:50%; background:#101B18; color:#fff; font-family:var(--serif); font-size:1rem; font-weight:600; display:flex; align-items:center; justify-content:center; }
  .tb .steps b{ display:block; font-family:var(--serif); font-size:1.14rem; color:#101B18; margin:2px 0 4px; }
  .tb .steps p{ margin:0; font-size:.88rem; color:var(--mid); line-height:1.5; }

  .tb .sec{ font-family:var(--serif); font-weight:600; font-size:1.45rem; margin:44px 0 10px; color:#101B18; display:flex; align-items:center; gap:12px; scroll-margin-top:16px; }
  .tb .secn{ flex:none; width:28px; height:28px; border-radius:50%; background:var(--teal-ink); color:#fff; font-family:var(--sans); font-size:.9rem; display:flex; align-items:center; justify-content:center; }
  .tb .secnote, .tb .secnote2{ font-family:var(--sans); font-weight:400; font-size:.8rem; color:var(--faint); letter-spacing:0; }
  .tb .secnote2{ margin:-4px 0 12px; font-size:.86rem; }
  .tb .ck{ font-family:var(--mono); font-size:.64rem; text-transform:uppercase; color:var(--teal-ink); display:block; }
  .tb .hint{ margin:6px 0 0; font-size:.8rem; color:var(--mid); line-height:1.5; }
  .tb code{ font-family:ui-monospace, Consolas, monospace; font-size:.84em; background:#EEF3F1; border-radius:4px; padding:1px 5px; color:#101B18; word-break:break-word; }

  /* presets */
  .tb .presets{ display:grid; grid-template-columns:repeat(auto-fill,minmax(172px,1fr)); gap:10px; }
  .tb .preset{ font:inherit; text-align:left; cursor:pointer; border:1px solid; border-radius:12px; padding:12px 12px 10px; display:flex; flex-direction:column; gap:3px; min-width:0; transition:transform .12s, box-shadow .12s; box-shadow:0 1px 0 rgba(16,27,24,.04); }
  .tb .preset:hover{ transform:translateY(-1px); box-shadow:0 4px 14px rgba(16,27,24,.10); }
  .tb .preset.on{ outline:2.5px solid var(--teal-ink); outline-offset:2px; }
  .tb .pn{ font-size:1.12rem; font-weight:600; line-height:1.15; letter-spacing:.02em; }
  .tb .pm{ font-size:.74rem; line-height:1.35; min-height:2em; }
  .tb .pstrip{ display:flex; height:14px; border-radius:4px; overflow:hidden; margin-top:6px; }
  .tb .pstrip i{ flex:1; }

  .tb .inputs{ display:grid; grid-template-columns:1fr 1fr; gap:12px; margin:14px 0 0; }
  .tb .card{ background:var(--panel); border:1px solid var(--hair-2); border-radius:14px; padding:14px 16px; min-width:0; }
  .tb textarea{ width:100%; margin:8px 0 0; font:inherit; font-family:ui-monospace, Consolas, monospace; font-size:.82rem; border:1px solid var(--hair-2); border-radius:10px; padding:9px 11px; background:#fff; color:#101B18; resize:vertical; box-sizing:border-box; }
  .tb .row{ display:flex; align-items:center; justify-content:space-between; gap:10px; margin-top:8px; flex-wrap:wrap; }
  .tb .found{ font-size:.82rem; color:var(--mid); display:flex; align-items:center; gap:3px; flex-wrap:wrap; }
  .tb .found i{ width:14px; height:14px; border-radius:3px; display:inline-block; border:1px solid rgba(0,0,0,.12); }
  .tb .drop{ border-style:dashed; cursor:pointer; display:flex; flex-direction:column; justify-content:center; text-align:center; transition:border-color .15s, background .15s; }
  .tb .drop .ck{ text-align:left; }
  .tb .drop .dl{ margin:12px 0 0; }
  .tb .drop .dl b{ color:#101B18; }
  .tb .drop.over{ border-color:var(--teal); background:var(--teal-wash); }
  .tb .drop button{ font:inherit; font-weight:600; border:none; background:none; color:var(--teal-ink); cursor:pointer; text-decoration:underline; padding:0; }
  .tb .status{ min-height:1.4em; margin:10px 0 0; font-size:.86rem; color:var(--teal-ink); }
  .tb .status.err{ color:var(--fail); }

  .tb .btn2{ font:inherit; font-size:.84rem; font-weight:600; background:#fff; color:var(--teal-ink); border:1px solid var(--teal-ink); border-radius:9px; padding:7px 12px; cursor:pointer; line-height:1.25; }
  .tb .btn2:hover:not([disabled]){ background:var(--teal-wash); }
  .tb .btn2[disabled]{ opacity:.45; cursor:default; }
  .tb .btn2.quiet{ border-color:var(--hair-2); color:var(--mid); }
  .tb .btn2.small{ padding:4px 10px; font-size:.78rem; }
  .tb .btnrow{ display:flex; flex-wrap:wrap; gap:8px; margin-top:10px; }

  /* editor + stage */
  .tb .work{ display:grid; grid-template-columns:minmax(300px,370px) minmax(0,1fr); gap:22px; align-items:start; }
  .tb .editor{ background:var(--panel); border:1px solid var(--hair-2); border-radius:14px; padding:16px; min-width:0; }
  .tb .field{ padding:0 0 14px; margin:0 0 14px; border-bottom:1px solid var(--hair); }
  .tb .field:last-of-type{ border-bottom:none; }
  .tb .fhead{ display:flex; justify-content:space-between; align-items:baseline; }
  .tb .fnote{ font-size:.74rem; color:var(--faint); }
  .tb input[type=text]{ font:inherit; font-size:.9rem; border:1px solid var(--hair-2); border-radius:8px; padding:6px 9px; background:#fff; color:#101B18; min-width:0; box-sizing:border-box; }
  .tb #tb-name{ width:100%; margin-top:6px; }
  .tb input[type=text].bad{ border-color:var(--fail); background:#FFF6F4; }
  .tb input[type=color]{ width:34px; height:30px; padding:0; border:1px solid var(--hair-2); border-radius:7px; background:#fff; cursor:pointer; flex:none; }
  .tb input[type=color]::-webkit-color-swatch-wrapper{ padding:2px; }
  .tb input[type=color]::-webkit-color-swatch{ border:none; border-radius:5px; }
  .tb .colors{ list-style:none; padding:0; margin:10px 0 8px; display:flex; flex-direction:column; gap:6px; }
  .tb .colors li{ display:flex; align-items:center; gap:6px; }
  .tb .cn{ flex:none; width:20px; font-size:.74rem; font-weight:600; color:var(--faint); text-align:right; }
  .tb .colors li.off .cn{ color:#C4CCC9; }
  .tb .colors input[type=text]{ width:88px; font-family:ui-monospace, Consolas, monospace; font-size:.84rem; text-transform:uppercase; }
  .tb .ib{ flex:none; width:28px; height:28px; border:1px solid var(--hair-2); border-radius:7px; background:#fff; color:var(--mid); cursor:pointer; font-size:.86rem; line-height:1; padding:0; }
  .tb .ib:hover:not([disabled]){ border-color:var(--teal-ink); color:var(--teal-ink); }
