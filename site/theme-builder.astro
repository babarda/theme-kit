function extractColors(text) {
  const out = [];
  const add = (h) => { h = tk.normHex(h); if (h && !out.includes(h)) out.push(h); };
  const re = /rgba?\(\s*(\d{1,3})\s*,\s*(\d{1,3})\s*,\s*(\d{1,3})[^)]*\)|#([0-9a-f]{6}|[0-9a-f]{3})(?![0-9a-z])|(?:\b0x|\b)([0-9a-f]{6})\b/gi;
  for (const m of String(text).matchAll(re)) {
    if (m[1] !== undefined) add(tk.rgbToHex([+m[1], +m[2], +m[3]].map((v) => Math.min(255, v))));
    else add(m[4] || m[5]);
  }
  return out;
}

function greyish(h) { const [r, g, b] = tk.hexToRgb(h); return Math.max(r, g, b) - Math.min(r, g, b) < 28; }

function brandFromPaste(cols) {
  const roles = {};
  let data = cols.filter((c) => {
    const L = tk.luminance(c);
    if (greyish(c) && L > 0.8 && !roles.background) { roles.background = c; return false; }
    if (greyish(c) && L > 0.8 && roles.background && !roles.panel) { roles.panel = c; return false; }
    if (L < 0.035 && !roles.ink) { roles.ink = c; return false; }
    return true;
  });
  if (!data.length) { data = cols.slice(); for (const k in roles) delete roles[k]; }
  const name = PRESETS.some((p) => p.name === B.name) ? "My Brand" : B.name;
  const keep = { fontHeading: B.fontHeading, fontBody: B.fontBody, good: B.good, bad: B.bad, neutral: B.neutral };
  return { brand: { ...fromFew(data, name), ...keep, ...roles }, roles, padded: data.length <= 3 };
}

