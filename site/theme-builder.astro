/* ---------------------------------------------------------------- preview drawing */

const ff = (f) => `'${String(f).replace(/['"<>&;]/g, "")}', 'Segoe UI', system-ui, sans-serif`;
function T(x, y, str, o = {}) {
  return `<text x="${x}" y="${y}" font-size="${o.size || 13}" fill="${o.fill}" font-family="${esc(o.font)}"${o.weight ? ` font-weight="${o.weight}"` : ""}${o.anchor ? ` text-anchor="${o.anchor}"` : ""}>${esc(str)}</text>`;
}
function palette() {
  const C = (h) => (vision === "normal" ? h : tk.simulate(h, vision));
  const p = { cs: B.colors.map(C), HF: ff(B.fontHeading), BF: ff(B.fontBody) };
  for (const k of ["background", "panel", "ink", "body", "hairline", "gridline", "good", "bad", "neutral"]) p[k] = C(B[k]);
  return p;
}
const onFill = (fill, p) => (tk.contrast(fill, p.ink) >= tk.contrast(fill, p.background) ? p.ink : p.background);

function panelBox(x, y, w, h, p, title) {
  return `<rect x="${x}" y="${y}" width="${w}" height="${h}" rx="6" fill="${p.panel}" stroke="${p.hairline}"/>` + (title ? T(x + 18, y + 30, title, { size: 16, fill: p.ink, font: p.HF, weight: 600 }) : "");
}

function legend(x, y, items, p, right) {
  let out = "", cx = x;
  const widths = items.map(([name]) => 24 + name.length * 8 + 14);
  if (right) cx = x - widths.reduce((a, b) => a + b, 0);
  items.forEach(([name, col], i) => { out += `<rect x="${cx}" y="${y - 10}" width="12" height="12" rx="2" fill="${col}"/>` + T(cx + 16, y + 1, name, { size: 14, fill: p.body, font: p.BF }); cx += widths[i]; });
  return out;
}

